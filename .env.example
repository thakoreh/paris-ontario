NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Local development: http://localhost:3000. Production: https://parispulse.ca
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=
RESEND_API_KEY=
EMAIL_FROM=Paris Pulse <hello@example.com>
OPENAI_API_KEY=
CRON_SECRET=
# Generate once; private key stays server-only. Never rotate without resubscribing browsers.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:your-monitored-support-address@example.com
# Optional external dead-man monitor. Configure only after approving provider setup.
# Export in the publisher cron environment; do not expose as NEXT_PUBLIC or commit a real URL.
# Healthchecks: 4-hour period + 1-hour grace; success pings only after completed review.
PARIS_PULSE_HEARTBEAT_URL=

# Anonymous intake is OFF until migration, trusted proxy and retention review.
# Never expose these settings as NEXT_PUBLIC. Existing Supabase service key is reused.
COMMUNITY_SUBMISSIONS_ENABLED=false
# Must be overwritten by a trusted proxy; direct access around it must be blocked.
# Supported: x-real-ip or cf-connecting-ip. Never use x-forwarded-for.
SUBMISSION_TRUSTED_IP_HEADER=
# Deployment-specific random secret, at least 32 characters. Operator-provided only.
SUBMISSION_RATE_LIMIT_SALT=
